# Loaded only when running `npm run dev`. Overrides `.env` for Vite.
# Use the dev-server proxy in vite.config.ts so backend requests are same-origin.
VITE_API_BASE=/api
VITE_AGENTS_API_URL=/api/agents
VITE_CALLS_API_URL=/api/calls
VITE_DASHBOARD_API_URL=/api/dashboard
VITE_AGENT_ATTENDANCE_API_URL=/api/agent-attendance
VITE_AGENT_SHIFT_SCHEDULES_API_URL=/api/agent-shift-schedules
VITE_AGENT_LEAVE_REQUESTS_API_URL=/api/agent-leave-requests
VITE_SYSTEM_AUDIT_LOGS_API_URL=/api/system-audit-logs
VITE_DID_MAPPINGS_API_URL=/api/did-mappings
VITE_AGENT_CHAT_API_URL=/api/agent-chat
VITE_BMS_API_URL=/api/bms-black
VITE_BMS_SUPPORT_CHAT_API_URL=/api/bms-black
VITE_CALL_CENTER_API_URL=/api/bms-black
